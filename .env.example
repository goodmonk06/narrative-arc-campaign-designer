# Database
DATABASE_URL="postgresql://narrativeuser:narrativepass@localhost:5432/narrative_arc_db?schema=public"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# Next.js
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Logging
LOG_LEVEL="debug" # debug | info | warn | error

# Metrics
METRICS_ENABLED="true"

# External Integrations (optional)
# RITUAL_ORCHESTRATOR_API_URL="https://ritual-orchestrator.example.com/api"
# RITUAL_ORCHESTRATOR_API_KEY="your-api-key"
# CONTENT_CALENDAR_API_URL="https://content-calendar.example.com/api"
# CONTENT_CALENDAR_API_KEY="your-api-key"

# AI Features (optional)
# OPENAI_API_KEY="your-openai-key"
# AI_SUGGESTIONS_ENABLED="false"

# Authentication (optional - for future implementation)
# AUTH_SECRET="your-secret-key"
# AUTH_PROVIDERS="email,google"

# Rate Limiting
RATE_LIMIT_ENABLED="false"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
